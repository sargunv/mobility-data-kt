amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

// Git-LFS fixtures. dprint.jsonc already skips them; keep hk from matching them via dprint's **/* glob.
exclude = List("sample-data")

// Shared by the pre-commit, check, and fix hooks hk derives from this map.
steps {
  // formatters
  ["dprint"] = (Builtins.dprint) { exclude = List("sample-data") }

  // linters
  ["jactionlint"] = Builtins.jactionlint

  ["detekt"] {
    glob = List("**/src/commonMain/kotlin/**/*.kt")
    check = "./gradlew detekt"
    exclusive = true
  }

  // Pin identity for the vendored Mobility Database Catalog OpenAPI.
  ["mdb-spec"] {
    glob = List("mdb-v1/specs/**")
    check = "scripts/mdb-spec-check.sh"
  }

  // generators
  ["abi-dump"] {
    glob = List("**/src/commonMain/kotlin/**/*.kt", "**/api/*.api", "**/api/*.klib.api")
    check = "./gradlew checkKotlinAbi"
    fix = "./gradlew updateKotlinAbi"
    exclusive = true
  }
}
